# Set this to the approved production domain when available.
# Leave empty to derive canonical and social URLs from the incoming request.
NEXT_PUBLIC_SITE_URL=

# Keep false while company claims, photos, and contact information are drafts.
# Set true only when the company content is approved for public indexing.
SITE_INDEXABLE=false

# Runtime-only contact form settings. No Gmail password is used by SMTP relay.
# Keep disabled until the VPS IP is allowed in Workspace and Turnstile is ready.
CONTACT_ENABLED=false
# Admin-controlled comma-separated internal recipients (max 5 including support).
# support@gr-tech.id is always included. Additional recipients receive BCC copies.
CONTACT_RECIPIENTS=support@gr-tech.id
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Persistent directory, writable by the non-root application user.
CONTACT_STATE_DIR=/app/contact-state
